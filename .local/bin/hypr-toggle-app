#!/bin/sh
# Put this in .config/hypr/hyprland.lua

cls="$1"
if [ "$cls" = "signal" ]
then
    cmd="signal-desktop"
fi

ws="special:app-$cls"

window_info="$(hyprctl -j clients | jq -e --arg cls "$cls" 'map(select(.class == $cls))[0]')"
if [ "$?" = 0 ]
then
    # echo "Window exists"
    pinned="$(echo "$window_info" | jq '.pinned')"
    if [ "$pinned" = "true" ]
    then
        # hide
        hyprctl --batch "dispatch hl.dsp.window.pin({ window = 'class:$cls' }) ; dispatch hl.dsp.window.move({ workspace = '$ws', follow = false, window = 'class:$cls' })"
    else
        # show
        curr_ws="$(hyprctl -j activeworkspace | jq '.id')"
        hyprctl --batch "dispatch hl.dsp.window.move({ workspace = ${curr_ws}, window = 'class:$cls' }) ; dispatch hl.dsp.window.alter_zorder({ mode = 'top', window = 'class:$cls' }) ; dispatch hl.dsp.window.pin({ window = 'class:$cls' })"
    fi
else
    dunstify "⚠️ '$cls' is not running!
    Run '$cmd'"
    # dunstify "Running '$cmd'"
    # "$cmd" &
fi
